{
    "name": "abap2ui5-layout-management",
    "private": true,
    "version": "1.0.0",
    "description": "Layout Management for abap2UI5.",
    "scripts": {
        "syfixes": "find . -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} + ",
        "strip_trailing_ws": "find src -type f -name '*.abap' -exec sed -i 's/[[:space:]]\\+$//' {} +",
        "abaplintpathfix": "sed -i 's|\"files\": \"/\\.\\.\\/\\.\\.\\/src\\/\\*\\*\\/\\*\\.\\*\"|\"files\": \"/src/**/*.*\"|g' abaplint.jsonc",
        "downport": "abaplint --fix .github/abaplint/abap_702.jsonc && npm run syfixes",
        "auto_downport": "abaplint --fix .github/abaplint/abap_702.jsonc && npm run syfixes && npm run strip_trailing_ws && cp -f .github/abaplint/abap_702.jsonc abaplint.jsonc && npm run abaplintpathfix",
        "rename": "abaplint .github/abaplint/rename.json --rename"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abap2UI5-addons/layout-management.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/abap2UI5-addons/layout-management/issues"
    },
    "homepage": "https://github.com/abap2UI5-addons/layout-management#readme",
    "devDependencies": {
        "@abaplint/cli": "^2.119.49"
    }
}
